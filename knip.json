{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/main.ts",
    "src/ports/*.ts",
    "src/core/domain/*.ts",
    "test/fakes/*.ts",
    "atta.config.example.ts",
    "src/core/run.ts"
  ],
  "project": ["src/**/*.ts", "test/**/*.ts", "atta.config.example.ts"],
  "ignore": [".repos/**"],
  "ignoreDependencies": [
    "@earendil-works/pi-durable",
    "@earendil-works/pi-ai",
    "@earendil-works/chord",
    "@earendil-works/pi-schema",
    "@effect/sql-sqlite-node",
    "@modelcontextprotocol/sdk",
    "@slack/bolt",
    "@slack/web-api"
  ]
}
